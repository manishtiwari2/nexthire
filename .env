# NextHire Local Development Configuration
#
# NOTE: the Express server does NOT read this file. `require('dotenv').config()` runs with
# server/ as the working directory, so `server/.env` is the file that takes effect — put
# server settings (Google credentials, mail, admin list) there. This root file is kept for
# tooling run from the repository root.
PORT=5000
DATABASE_URL="postgresql://nexthire:nexthire_password@localhost:5432/nexthire_db?schema=public"
JWT_SECRET="iG3rr05gU0ZkDZhla8sYAYofICgGjFp6yYnvBZdurPT"
# The port Vite serves the app on (see client/vite.config.js). Verification and password
# reset emails link here, and it must be an allowed CORS origin for the refresh cookie.
CLIENT_URL="http://localhost:3000"
NODE_ENV="development"

# ---- Authorization -------------------------------------------------------
# These addresses get ADMIN on every sign-in; everyone else is USER.
ADMIN_EMAILS="manishtiwari2578@gmail.com,su-24071@sitare.org,anuradhatiwari2401@gmail.com,su-24019@sitare.org"

# ---- Google OAuth 2.0 ----------------------------------------------------
# PASTE YOUR CREDENTIALS HERE, then restart the server.
#
# Get them from https://console.cloud.google.com/apis/credentials
#   → Create credentials → OAuth client ID → Web application
#   Authorized JavaScript origins : http://localhost:5173
#   Authorized redirect URIs      : http://localhost:5000/api/v1/auth/google/callback
#
# Client ID alone  -> Google Identity Services flow (ID token verified server-side).
# ID + secret      -> full server-side authorization-code flow (preferred).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5000/api/v1/auth/google/callback"

# ---- Email ---------------------------------------------------------------
# Development: verification / reset links are printed to the server console.
MAIL_PROVIDER="console"
MAIL_FROM="NextHire <no-reply@nexthire.local>"

# ---- Auth behaviour ------------------------------------------------------
EMAIL_VERIFICATION_REQUIRED="true"
TRUST_PROXY="false"
