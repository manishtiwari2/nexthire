datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  USER
  // Reserved for the interviewer experience (panel/host tooling). No permissions are
  // granted to it yet beyond USER — see shared/authz.js for the permission matrix.
  INTERVIEWER
  /// @deprecated Legacy name for USER. Retained so existing rows stay readable during
  /// migration; `scripts/migrateAuth.js` rewrites CANDIDATE -> USER.
  CANDIDATE
}

// Which credential a login/session was established with.
enum AuthProvider {
  PASSWORD
  GOOGLE
}

// Single-use, hashed tokens emailed to the user.
enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// Audit trail for the account security timeline (surfaced in Profile + Admin).
enum AuthEventType {
  REGISTER
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  LOGOUT_ALL
  TOKEN_REFRESH
  TOKEN_REUSE_DETECTED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET
  PASSWORD_CHANGED
  EMAIL_VERIFIED
  ACCOUNT_LOCKED
  ACCOUNT_DISABLED
  ACCOUNT_ENABLED
  ROLE_CHANGED
  GOOGLE_LINKED
  GOOGLE_UNLINKED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Language {
  PYTHON
  JAVASCRIPT
  TYPESCRIPT
  CPP
  JAVA
  GO
}

enum ContestStatus {
  UPCOMING
  LIVE
  ENDED
}

// Where a referenced problem originates. Extensible: new platforms are added here,
// but the browse API also accepts arbitrary source strings so data can lead schema.
enum SourcePlatform {
  LEETCODE
  GEEKSFORGEEKS
  HACKERRANK
  CODEFORCES
  CODECHEF
  ATCODER
  INTERVIEWBIT
  CUSTOM
}

// How often a problem is reported in interviews (coarse band; frequencyScore holds a finer 0-100 value).
enum FrequencyBand {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

// Authoring/curation lifecycle of a question ("Revision Status" in the product brief).
enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

// A user's personal solve state for a question.
enum ProgressStatus {
  TODO
  ATTEMPTED
  SOLVED
}

// Curated (system) study sheets vs. user-authored ones.
enum SheetKind {
  SYSTEM
  CUSTOM
}

enum InterviewStatus {
  SCHEDULED
  WAITING_ROOM
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SubmissionStatus {
  PENDING
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  OUTPUT_LIMIT_EXCEEDED
  COMPILATION_ERROR
  RUNTIME_ERROR
  INTERNAL_ERROR
  CANCELLED
}

enum SubmissionContext {
  PRACTICE
  CONTEST
  INTERVIEW
}

enum ParticipantRole {
  CANDIDATE
  INTERVIEWER
  OBSERVER
}

enum NotificationType {
  SYSTEM
  CONTEST
  INTERVIEW
  SUBMISSION
  AI_INSIGHT
}

// ==========================================
// USER & AUTHENTICATION
// ==========================================

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  name                  String
  role                  Role                   @default(USER)
  /// Profile picture. Historic column name; `avatar` in the API DTO maps to this.
  avatarUrl             String?
  googleId              String?                @unique
  /// Legacy flag kept for backward compatibility with pre-auth-rewrite rows and any
  /// code that still reads it. `emailVerified` is the field the auth system enforces.
  isVerified            Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  // --- Credentials ---
  /// bcrypt hash (12 rounds). Null for Google-only accounts. Never serialised.
  passwordHash          String?
  passwordChangedAt     DateTime?
  /// E.164 phone number, unique across accounts. Null for Google-created accounts
  /// until the user completes their profile.
  mobile                String?                @unique

  // --- Verification ---
  emailVerified         Boolean                @default(false)
  emailVerifiedAt       DateTime?
  mobileVerified        Boolean                @default(false)

  // --- Account state ---
  isActive              Boolean                @default(true)
  disabledReason        String?
  /// Bumped on "log out everywhere", password change/reset, disable, and role change.
  /// Access tokens carry the version they were minted with and are rejected once stale.
  tokenVersion          Int                    @default(0)
  failedLoginAttempts   Int                    @default(0)
  lockedUntil           DateTime?

  // --- Activity ---
  lastLogin             DateTime?
  lastActive            DateTime?

  sessions              Session[]
  authTokens            AuthToken[]
  authEvents            AuthEvent[]

  profile               Profile?
  submissions           Submission[]
  contestParticipants   ContestParticipant[]
  interviewParticipants InterviewParticipant[]
  revisionSchedules     RevisionSchedule[]
  createdContests       Contest[]              @relation("ContestHost")
  createdInterviews     Interview[]            @relation("InterviewHost")
  createdInvites        ContestInvite[]        @relation("InviteCreator")
  notifications         Notification[]
  aiFeedbacks           AIFeedback[]
  aiHintRequests        AIHintRequest[]
  studySheets           StudySheet[]           @relation("SheetOwner")
  questionProgress      UserQuestionProgress[]
  questionNotes         UserQuestionNote[]
}

/// One row per signed-in device. Holds the *hash* of a refresh token, never the token
/// itself, so a database leak cannot be replayed. Rotation replaces the row's hash and
/// records the previous one in `previousTokenHash` for one-step reuse detection.
model Session {
  id                String       @id @default(uuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// sha256 of the current refresh token.
  tokenHash         String       @unique
  /// sha256 of the token this one replaced. If a client presents it again, the family
  /// has been stolen/replayed and every session for the user is revoked.
  previousTokenHash String?      @unique
  provider          AuthProvider @default(PASSWORD)
  /// "Remember me" sessions get the long refresh TTL and a persistent cookie.
  rememberMe        Boolean      @default(false)
  userAgent         String?
  browser           String?
  os                String?
  device            String?
  ipAddress         String?
  expiresAt         DateTime
  lastUsedAt        DateTime     @default(now())
  revokedAt         DateTime?
  revokedReason     String?
  createdAt         DateTime     @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Single-use email verification / password reset tokens. Only the sha256 hash is
/// stored, so the raw token exists solely inside the emailed link.
model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

/// Security timeline. `userId` is null for failed logins against unknown emails so
/// the event is still rate-limit auditable without leaking account existence.
model AuthEvent {
  id        String        @id @default(uuid())
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Lowercased email the attempt was made with (kept even when userId is null).
  email     String?
  type      AuthEventType
  provider  AuthProvider?
  /// Short machine-readable outcome, e.g. "invalid_password", "account_disabled".
  detail    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([type, createdAt])
}

model Profile {
  id          String         @id @default(uuid())
  userId      String         @unique
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio         String?
  githubUrl   String?
  linkedinUrl String?
  userSkills  ProfileSkill[]
}

model ProfileSkill {
  id        String   @id @default(uuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skillName String
}

// ==========================================
// QUESTION BANK & TOPICS
// ==========================================

model Topic {
  id        String     @id @default(uuid())
  name      String     @unique
  slug      String     @unique
  questions Question[]
}

model Question {
  id               String             @id @default(uuid())
  title            String
  slug             String             @unique
  difficulty       Difficulty         @default(EASY)
  topicId          String
  topic            Topic              @relation(fields: [topicId], references: [id])
  description      String
  constraints      String
  timeLimitMs      Int                @default(2000)
  memoryLimitMb    Int                @default(256)

  // --- Question Library metadata ---
  subtopics        String[]           @default([])
  frequencyBand    FrequencyBand?
  frequencyScore   Int?               // finer 0-100 signal when known
  estimatedTimeMin Int?               // estimated solve time in minutes
  sourcePlatform   SourcePlatform     @default(CUSTOM)
  sourceUrl        String?
  originalAuthor   String?
  authorNotes      String?            // author/maintainer notes (not the private per-user notes)
  contentStatus    ContentStatus      @default(PUBLISHED)
  acceptanceRate   Float?             // internal, if tracked (0-100)
  // Reference-only problems store metadata + a source link but no local statement/tests;
  // the solve page links out instead of running the judge.
  isExternalOnly   Boolean            @default(false)

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  starterCodes     StarterCode[]
  testCases        TestCase[]
  hints            Hint[]
  editorial        Editorial?
  questionTags     QuestionTagMap[]
  companyTags      CompanyTagMap[]
  contestQuestions ContestQuestion[]
  submissions      Submission[]
  revisions        RevisionSchedule[]
  interviews       Interview[]
  aiHintRequests   AIHintRequest[]
  sheetItems       SheetItem[]
  progress         UserQuestionProgress[]
  userNotes        UserQuestionNote[]

  @@index([topicId])
  @@index([sourcePlatform])
  @@index([frequencyBand])
}

model StarterCode {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  language   Language
  template   String

  @@unique([questionId, language])
}

model TestCase {
  id             String   @id @default(uuid())
  questionId     String
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  input          String
  expectedOutput String
  explanation    String?
  isSample       Boolean  @default(false)
  orderIndex     Int      @default(0)
}

model Hint {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  orderIndex Int
  content    String
}

model Editorial {
  id         String   @id @default(uuid())
  questionId String   @unique
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  content    String
  solution   String
}

model Tag {
  id        String           @id @default(uuid())
  name      String           @unique
  questions QuestionTagMap[]
}

model QuestionTagMap {
  questionId String
  tagId      String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
}

model CompanyTag {
  id        String          @id @default(uuid())
  name      String          @unique
  questions CompanyTagMap[]
}

model CompanyTagMap {
  questionId   String
  companyTagId String
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  companyTag   CompanyTag @relation(fields: [companyTagId], references: [id], onDelete: Cascade)

  @@id([questionId, companyTagId])
}

// ==========================================
// SPACED REPETITION / REVISION SCHEDULE
// ==========================================

model RevisionSchedule {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  intervalDays   Int       @default(1)
  easeFactor     Float     @default(2.5)
  reviewCount    Int       @default(0)
  lastReviewedAt DateTime  @default(now())
  nextReviewAt   DateTime

  @@unique([userId, questionId])
}

// ==========================================
// STUDY SHEETS (curated + user-authored)
// ==========================================

model StudySheet {
  id          String      @id @default(uuid())
  name        String
  slug        String      @unique
  description String?
  kind        SheetKind   @default(CUSTOM)
  ownerId     String?     // null for SYSTEM sheets
  owner       User?       @relation("SheetOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  isPublic    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items       SheetItem[]

  @@index([ownerId])
  @@index([kind])
}

model SheetItem {
  id         String     @id @default(uuid())
  sheetId    String
  sheet      StudySheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  questionId String
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  section    String?    // optional grouping label within the sheet (e.g. "Arrays")
  orderIndex Int        @default(0)

  @@unique([sheetId, questionId])
  @@index([sheetId])
}

// ==========================================
// PER-USER PROGRESS & PRIVATE NOTES
// ==========================================

model UserQuestionProgress {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId      String
  question        Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  status          ProgressStatus @default(TODO)
  attempts        Int            @default(0)
  acceptedCount   Int            @default(0)
  totalSolveSec   Int            @default(0) // accumulated solve time
  solveSessions   Int            @default(0) // count of timed sessions (avg = totalSolveSec / solveSessions)
  isBookmarked    Boolean        @default(false)
  firstSolvedAt   DateTime?
  lastPracticedAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
  @@index([userId, status])
}

// Private, per-user preparation notes. Always scoped to the owning user by the API.
model UserQuestionNote {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId      String
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  approach        String?
  mistakes        String?
  edgeCases       String?
  timeComplexity  String?
  spaceComplexity String?
  keyInsights     String?
  revisionNotes   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, questionId])
  @@index([userId])
}

// ==========================================
// CONTESTS, INVITES & PARTICIPATION
// ==========================================

model Contest {
  id           String               @id @default(uuid())
  title        String
  description  String
  bannerUrl    String?
  startTime    DateTime
  endTime      DateTime
  status       ContestStatus        @default(UPCOMING)
  hostId       String
  host         User                 @relation("ContestHost", fields: [hostId], references: [id])
  createdAt    DateTime             @default(now())

  questions    ContestQuestion[]
  participants ContestParticipant[]
  invites      ContestInvite[]
  submissions  Submission[]
}

model ContestQuestion {
  id         String   @id @default(uuid())
  contestId  String
  contest    Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  orderIndex Int
  points     Int      @default(100)

  @@unique([contestId, questionId])
}

model ContestInvite {
  id         String    @id @default(uuid())
  contestId  String
  contest    Contest   @relation(fields: [contestId], references: [id], onDelete: Cascade)
  code       String    @unique
  creatorId  String
  creator    User      @relation("InviteCreator", fields: [creatorId], references: [id])
  maxUses    Int?
  usedCount  Int       @default(0)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
}

model ContestParticipant {
  id              String    @id @default(uuid())
  contestId       String
  contest         Contest   @relation(fields: [contestId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  registeredAt    DateTime  @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  lastHeartbeatAt DateTime?
  score           Int       @default(0)
  penalty         Int       @default(0)
  isDisqualified  Boolean   @default(false)
  rank            Int?

  @@unique([contestId, userId])
}

// ==========================================
// INTERVIEWS & PARTICIPATION
// ==========================================

model Interview {
  id           String                 @id @default(uuid())
  roomCode     String                 @unique
  position     String
  scheduledAt  DateTime
  status       InterviewStatus        @default(SCHEDULED)
  hostId       String
  host         User                   @relation("InterviewHost", fields: [hostId], references: [id])
  problemId    String?
  problem      Question?              @relation(fields: [problemId], references: [id])

  participants InterviewParticipant[]
  submissions  Submission[]
  report       InterviewReport?
  aiSessions   AIInterviewerSession[]
}

model InterviewParticipant {
  id          String          @id @default(uuid())
  interviewId String
  interview   Interview       @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        ParticipantRole @default(CANDIDATE)
  joinedAt    DateTime?

  @@unique([interviewId, userId])
}

model InterviewReport {
  id                  String    @id @default(uuid())
  interviewId         String    @unique
  interview           Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  overallScore        Int
  problemSolvingScore Int
  codeQualityScore    Int
  communicationScore  Int
  systemDesignScore   Int
  feedback            String
  strengths           String
  improvements        String
  createdAt           DateTime  @default(now())
}

// ==========================================
// SUBMISSIONS & SEPARATE EXECUTION RESULTS
// ==========================================

model Submission {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  context     SubmissionContext @default(PRACTICE)
  contestId   String?
  contest     Contest?          @relation(fields: [contestId], references: [id])
  interviewId String?
  interview   Interview?        @relation(fields: [interviewId], references: [id])
  code        String
  language    Language
  status      SubmissionStatus  @default(PENDING)
  /// "Run" (try the samples) rather than "Submit" (final attempt against every test).
  /// A trial run is judged against SAMPLE test cases only, is excluded from submission
  /// history, and never touches progress, streaks, acceptance rate or contest score.
  /// It still needs a row because the verdict is delivered by submission id.
  isTrialRun  Boolean           @default(false)
  createdAt   DateTime          @default(now())

  executions  ExecutionResult[]

  @@index([userId])
  @@index([questionId])
  @@index([contestId])
  @@index([interviewId])
  // History and progress queries always filter trial runs out.
  @@index([userId, isTrialRun])
}

model ExecutionResult {
  id             String           @id @default(uuid())
  submissionId   String
  submission     Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  status         SubmissionStatus @default(PENDING)
  language       Language?
  executionTime  Float?
  memoryUsed     Float?
  passCount      Int              @default(0)
  totalTestCases Int              @default(0)
  compilerOutput String?
  runtimeOutput  String?
  stderr         String?
  exitCode       Int?
  // Per-test breakdown: [{ index, isSample, verdict, executionTime, memoryUsed, exitCode, stdout, stderr, expectedOutput }].
  // Hidden (non-sample) case I/O is stripped by the API DTO before it reaches non-admin clients.
  testResults    Json?
  judgedAt       DateTime         @default(now())

  @@index([submissionId])
}

// ==========================================
// NOTIFICATIONS
// ==========================================

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
}

// ==========================================
// AI EXTENSION POINTS (FUTURE RESERVED SCHEMA)
// ==========================================

model AIFeedback {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeSnippet    String
  suggestedFix   String
  explanation    String
  createdAt      DateTime @default(now())
}

model AIHintRequest {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  hintText   String
  createdAt  DateTime @default(now())
}

model AIInterviewerSession {
  id          String    @id @default(uuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  transcript  String
  summary     String
  createdAt   DateTime  @default(now())
}
