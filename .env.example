# ==========================================
# NextHire — Environment Configuration
# ==========================================

# Backend Express Server Port
PORT=5000

# Database URL
# For local development with PostgreSQL (via Docker):
DATABASE_URL="postgresql://nexthire:nexthire_password@localhost:5432/nexthire_db?schema=public"
# For SQLite (zero-config, no Docker needed):
# DATABASE_URL="file:./dev.db"

# ==========================================
# Authentication & Authorization
# ==========================================

# Secret used to sign access-token JWTs. REQUIRED in production — the server refuses to
# boot with the dev default or anything shorter than 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="nexthire_dev_secret_jwt_key_2026"
# Optional: sign access tokens with a dedicated secret instead of JWT_SECRET.
# JWT_ACCESS_SECRET=""
# JWT_ISSUER="nexthire"
# JWT_AUDIENCE="nexthire-app"

# --- Admin allow-list -----------------------------------------------------
# Comma-separated. These addresses are granted ADMIN on every sign-in; every other
# account is USER. Removing an address here demotes that account on its next login.
# ADMIN is granted ONLY through this list — the admin API cannot hand it out.
ADMIN_EMAILS="manishtiwari2578@gmail.com,su-24071@sitare.org,anuradhatiwari2401@gmail.com,su-24019@sitare.org"

# --- Token & session lifetimes (seconds) ----------------------------------
ACCESS_TOKEN_TTL_SEC="900"                 # 15m — short, since it cannot be revoked mid-flight
REFRESH_TOKEN_TTL_SEC="604800"             # 7d  — normal sign-in
REFRESH_TOKEN_REMEMBER_TTL_SEC="2592000"   # 30d — "Remember me"
SESSION_IDLE_TIMEOUT_SEC="43200"           # 12h idle timeout (not applied to remembered sessions)
MAX_SESSIONS_PER_USER="10"                 # oldest session is evicted beyond this
EMAIL_VERIFICATION_TTL_SEC="86400"         # 24h
PASSWORD_RESET_TTL_SEC="3600"              # 1h

# --- Password policy & brute-force protection ------------------------------
BCRYPT_ROUNDS="12"
PASSWORD_MIN_LENGTH="8"
MAX_FAILED_LOGIN_ATTEMPTS="8"
LOGIN_LOCKOUT_SEC="900"                    # 15m lockout once the limit is hit

# --- Cookies --------------------------------------------------------------
# The refresh token is stored in an HTTP-only cookie; `secure` is forced on in production.
# COOKIE_DOMAIN=".example.com"             # set when the API and app are on subdomains
# COOKIE_SAME_SITE="lax"                   # "none" (+ secure) for a cross-site deployment
# COOKIE_SECURE="true"                     # force HTTPS-only cookies outside production

# --- Behaviour flags -------------------------------------------------------
# Require a verified email before sign-in. Set "false" for a demo without email delivery.
EMAIL_VERIFICATION_REQUIRED="true"
# Let login say "no account with this email" / "incorrect password" instead of one generic
# message. Convenient in development; leave off in production — it is a user-enumeration
# oracle. Defaults to on in development, off in production.
# AUTH_VERBOSE_LOGIN_ERRORS="false"
# Believe X-Forwarded-For / X-Real-IP. Enable ONLY behind a proxy you control, otherwise
# clients can spoof their IP and poison rate limits and audit records.
TRUST_PROXY="false"
# Disable rate limiting. Test-suite use only.
# DISABLE_RATE_LIMIT="0"

# ==========================================
# Google OAuth 2.0
# ==========================================
# Create an OAuth 2.0 Client ID (type: Web application) at
#   https://console.cloud.google.com/apis/credentials
#
#   Authorized JavaScript origins : http://localhost:5173
#   Authorized redirect URIs      : http://localhost:5000/api/v1/auth/google/callback
#
# With only GOOGLE_CLIENT_ID set, the app uses the Google Identity Services flow and
# verifies the returned ID token against Google's public keys.
# With the secret also set, it uses the full server-side authorization-code flow, which is
# preferred — no token ever passes through client-side JavaScript.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5000/api/v1/auth/google/callback"

# Also expose the client ID to the frontend (Vite only reads VITE_-prefixed vars).
# Optional: the sign-in page fetches it from GET /api/v1/auth/config as well.
VITE_GOOGLE_CLIENT_ID=""

# ==========================================
# Transactional Email
# ==========================================
# console  — development default. Prints the message (and link) to the server console;
#            nothing is sent. Production refuses to boot with this.
# smtp     — nodemailer over SMTP_URL. The usual production choice.
# resend   — Resend HTTP API (MAIL_API_KEY).
# sendgrid — SendGrid v3 HTTP API (MAIL_API_KEY).
MAIL_PROVIDER="console"
MAIL_FROM="NextHire <no-reply@nexthire.local>"
# SMTP_URL="smtps://user:pass@smtp.example.com:465"
# MAIL_API_KEY=""

# ==========================================
# Judge System (BullMQ + Redis + Docker)
# ==========================================

# Redis connection used by the BullMQ judge queue and the cross-process event relay.
REDIS_URL="redis://localhost:6379"

# Number of submissions the judge worker evaluates concurrently.
JUDGE_CONCURRENCY="4"

# Docker images used to compile/run each language inside the sandbox. Override to use
# your own prebaked images (see server/docker/). Defaults are official base images.
JUDGE_IMAGE_PYTHON="python:3.10-slim"
JUDGE_IMAGE_CPP="gcc:13"
JUDGE_IMAGE_JAVA="eclipse-temurin:17-jdk"

# DANGER: when "1", the worker executes untrusted code directly on the host via
# child_process instead of Docker. FOR LOCAL DEV ONLY on a machine without Docker.
# NEVER enable in production — it removes every sandbox protection.
JUDGE_UNSAFE_LOCAL="0"

# Frontend Client URL. Must match the port Vite serves on (client/vite.config.js -> 3000).
# Verification and password-reset emails link here, the Google callback redirects here, and
# it is an allowed CORS origin for the HTTP-only refresh cookie.
CLIENT_URL="http://localhost:3000"

# Additional credentialed CORS origins, comma-separated. Defaults in development to
# CLIENT_URL plus localhost:3000 and localhost:5173; in production, to CLIENT_URL alone.
# A wildcard is never used — the browser rejects `*` on credentialed requests.
# CORS_ORIGINS="https://app.example.com"

# Frontend Environment Variables (used by Vite)
VITE_API_URL="http://localhost:5000/api/v1"
VITE_SOCKET_URL="http://localhost:5000"

# Node Environment
NODE_ENV="development"
